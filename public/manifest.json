{
  "manifest_version": 3,
  "name": "LinkedIn Profile Visit Tracker",
  "version": "1.0.0",
  "description": "A Chrome extension track your activity for your analysis.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "optional_permissions": [
    "https://www.linkedin.com/*"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["**/*"],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}